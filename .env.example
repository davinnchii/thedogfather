## Public (safe to expose to browser)
NEXT_PUBLIC_UNDER_CONSTRUCTION=false

## Site (server-side)
SITE_URL=https://thedogfather.no
# Used for Vipps ePayment returnUrl (must match the public origin of this site).

## Vipps ePayment (server-side) — use Merchant Test (MT) / test server first
# Docs: https://developer.vippsmobilepay.com/docs/knowledge-base/test-environment/
# Test API host: https://apitest.vipps.no
# Optional override (default is apitest for development):
# VIPPS_API_BASE=https://apitest.vipps.no
# VIPPS_CLIENT_ID=
# VIPPS_CLIENT_SECRET=
# VIPPS_SUBSCRIPTION_KEY=
# VIPPS_MSN=
# Default amount in øre when POST /api/vipps/payment has no amountOre (e.g. 1000 = 10,00 NOK)
# VIPPS_DEFAULT_AMOUNT_ORE=1000
# Text shown in the Vipps app for the charge
# VIPPS_PAYMENT_DESCRIPTION=Betaling – The Dogfather
# Optional: MSISDN for MT test app prefill (e.g. 4742543640) — from portal test users
# VIPPS_TEST_USER_MSISDN=

## Calendly (server-side) - use ONE of these
# CALENDLY_API_TOKEN=
# CALENDLY_API_KEY=

## Google Places (server-side, used by /api/reviews)
# GOOGLE_PLACE_ID=ChIJ...
# GOOGLE_PLACES_API_KEY=
# GOOGLE_REVIEWS_CACHE_SECONDS=172800

## Contact email backend (server-side)
# In development, emails are sent when Resend/SMTP vars below are set.
# CONTACT_MOCK_EMAIL=true — validate only, never call Resend (overrides dev send)
# CONTACT_MOCK_EMAIL=false — always send when credentials exist (even in dev)
# Option A: Resend (sending domain: send.thedogfather.no)
# RESEND_API_KEY=
# Inbox for contact-form notifications (your real mailbox)
# EMAIL_TO=will@thedogfather.no
# Verified From on send.thedogfather.no — defaults to kontakt@send.thedogfather.no if unset
# EMAIL_FROM="The Dogfather <kontakt@send.thedogfather.no>"

# Option B: SMTP
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_USER=
# EMAIL_PASS=
