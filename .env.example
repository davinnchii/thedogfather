## Public (safe to expose to browser)
NEXT_PUBLIC_UNDER_CONSTRUCTION=false

## Site (server-side)
SITE_URL=https://example.com

## Calendly (server-side) - use ONE of these
# CALENDLY_API_TOKEN=
# CALENDLY_API_KEY=

## Google Places (server-side, used by /api/reviews)
# GOOGLE_PLACE_ID=ChIJ...
# GOOGLE_PLACES_API_KEY=
# GOOGLE_REVIEWS_CACHE_SECONDS=172800

## Contact email backend (server-side)
# Option A: Resend
# RESEND_API_KEY=
# EMAIL_TO=
# EMAIL_FROM=

# Option B: SMTP
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_USER=
# EMAIL_PASS=
